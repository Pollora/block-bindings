{
    "name": "pollora/block-bindings",
    "description": "WordPress Block Bindings declared with attributes: a #[BlockBinding] class is a source, its methods are fields, and the post meta, term meta, author meta and options Pollora ships are ready to bind. Runs with or without Laravel.",
    "type": "library",
    "keywords": [
        "block-bindings",
        "blocks",
        "gutenberg",
        "pollora",
        "wordpress"
    ],
    "homepage": "https://pollora.dev/blocks/block-bindings/",
    "license": "MIT",
    "authors": [
        {
            "name": "Amphibee",
            "email": "contact@amphibee.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/Pollora/block-bindings/issues",
        "source": "https://github.com/Pollora/block-bindings"
    },
    "require": {
        "php": "^8.3",
        "pollora/attributes": "^0.1.1 || ^1.0",
        "pollora/colt": "^11.0",
        "pollora/discovery": "^0.1 || ^1.0",
        "pollora/hook": "^2.0.1",
        "pollora/meta": "^0.1",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "antecedent/patchwork": "^2.2",
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.22.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.2",
        "phpstan/phpstan": "^2.1.16",
        "pollora/harness": "^0.1.15",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Pollora\\BlockBinding\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pollora\\BlockBinding\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@phpstan",
            "@lint:check"
        ],
        "test:unit": "pest",
        "test:coverage": "pest --coverage",
        "phpstan": "phpstan analyse",
        "phpstan:ci": "phpstan analyse --no-progress",
        "lint": "pint",
        "lint:check": "pint --test",
        "qa": "@php vendor/bin/pollora-qa check",
        "qa:fast": "@php vendor/bin/pollora-qa check --fast"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
